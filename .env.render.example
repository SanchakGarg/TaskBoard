# ---------- server ----------
PORT=3000
# Public URL of the app on Render, used for OAuth redirect URIs.
APP_URL=https://taskboard-1-127f.onrender.com
# Long random string. Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
# SQLite file location on Render. Attach a persistent disk at /data.
DB_PATH=/data/taskboard.db
NODE_ENV=production

# ---------- auth: enable any combination ----------
# Guest login: no identity provider needed. For demos and trusted LAN use only.
AUTH_GUEST_ENABLED=true

AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_ZITADEL_ENABLED=false
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# ---------- email (optional) ----------
# When SMTP_HOST is set, Taskboard emails workspace invites, task
# assignments, and overdue-deadline reminders (assignees, CC project managers).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taskboard <taskboard@example.com>"
