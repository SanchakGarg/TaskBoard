# ---------- server ----------
PORT=3000
# Public URL of the app (used for OAuth redirect URIs). Behind a reverse proxy,
# set this to the HTTPS URL, e.g. https://tasks.example.com
APP_URL=http://localhost:3000
# Long random string. Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
# SQLite file location (the Docker image sets this to /data/taskboard.db)
DB_PATH=./data/taskboard.db
NODE_ENV=production

# ---------- auth: enable any combination ----------
# Guest login: no identity provider needed — anyone with access to the URL
# shares one "Guest" account. For demos/LAN use only.
AUTH_GUEST_ENABLED=false

AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_ZITADEL_ENABLED=false
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
