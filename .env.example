# ---------- server ----------
PORT=3000
# Public URL of the app (used for OAuth redirect URIs). For local development,
# set this to http://localhost:3000.
APP_URL=http://localhost:3000
# Long random string. Generate one: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=
# 32-character string used to encrypt Google refresh tokens.
# Required if Google Sheets sync is used.
ENCRYPTION_KEY=
# Secret shared between the web service and cron job for the /api/cron/sweep endpoint.
# Leave empty locally — the in-process setInterval handles deadline emails instead.
CRON_SECRET=
# PostgreSQL connection string. 
# If running via `docker compose up`, leave this as the default 'postgres' hostname.
# The host port mapped to Postgres by Docker can be changed via DB_PORT (defaults to 5433).
# If running bare metal (bun run dev), change the hostname to 'localhost'.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/taskboard
DB_PORT=5433
NODE_ENV=development

# ---------- features ----------
# Set to false to entirely disable Google Sheets synchronization features.
# If disabled, no Google Drive/Sheets scopes will be requested during login.
ENABLE_SHEETS_SYNC=true

# ---------- auth: enable any combination ----------
# Guest login: no identity provider needed — anyone with access to the URL
# shares one "Guest" account. For demos/LAN use only.
AUTH_GUEST_ENABLED=true

AUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AUTH_ZITADEL_ENABLED=false
ZITADEL_ISSUER=https://your-instance.zitadel.cloud
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=

# ---------- email (optional) ----------
# When SMTP_HOST is set, Taskboard emails workspace invites, task
# assignments, and overdue-deadline reminders (assignees, CC project managers).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Taskboard <taskboard@example.com>"
